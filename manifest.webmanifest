{
  "name": "LotQuote Sales CRM",
  "short_name": "LotQuote",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141316",
  "theme_color": "#141316",
  "icons": [{ "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }],
  "share_target": {
    "action": "./?share=1",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
